# Claude Code setup token used by local proxy auth in this project.
# Overlay reads this value and uses it as proxy auth token.
CLAUDE_CODE_SETUP_TOKEN=your-claude-code-setup-token

# Optional: override local proxy URL (defaults to config.json value)
# CLAUDE_PROXY_BASE_URL=http://127.0.0.1:8317

# Whisper STT API key
WHISPER_API_KEY=your-whisper-api-key

# Optional overrides
# CLAUDE_MODEL=claude-haiku-4-5-20251001
# WHISPER_MODEL=whisper-1
# WHISPER_LANGUAGE=ru
# WHISPER_CHUNK_SECONDS=15
